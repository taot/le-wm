# Copy to .env (git-ignored) and set the storage root for this machine.
# train.py, eval.py and playground.py load it automatically; run `source .env`
# to use $STABLEWM_HOME in shell commands too. A value already set in the shell wins.
#
# Datasets go under $STABLEWM_HOME/datasets/, runs under $STABLEWM_HOME/checkpoints/.
# Your own machine: the default below. Cloud GPU machine: its local NVMe disk, e.g. /workspace/swm
export STABLEWM_HOME=${HOME}/.stable_worldmodel
