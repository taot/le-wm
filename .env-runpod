export STABLEWM_HOME=${HOME}/.stable_worldmodel
export UV_CACHE_DIR=/root/.cache/uv-local
export UV_LINK_MODE=copy
# The pod sees all host CPUs (128) but has a quota of ~14 and a limit of 8704
# threads. Without this, each DataLoader worker starts ~220 threads, and 32
# workers (train + val) reach the limit, so a worker exits with code 1.
export OMP_NUM_THREADS=1
